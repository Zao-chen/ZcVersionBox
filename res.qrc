  <file alias="info.svg">res/icons/info.svg</file>
  <file alias="add.svg">res/icons/add.svg</file>
  <file alias="file.svg">res/icons/file.svg</file>
  <file alias="more.svg">res/icons/more.svg</file>
  <file alias="refresh.svg">res/icons/refresh.svg</file>
  <file alias="compare.svg">res/icons/compare.svg</file>
  <file alias="preview.svg">res/icons/preview.svg</file>
  <file alias="restore.svg">res/icons/restore.svg</file>
  <file alias="copy.svg">res/icons/copy.svg</file>
  <file alias="close.svg">res/icons/close.svg</file>
