set(CPACK_GENERATOR DEB)
set(CPACK_PACKAGE_NAME zcversionbox)
set(CPACK_PACKAGE_VENDOR ZcVersionBox)
set(CPACK_PACKAGE_CONTACT "ZcVersionBox maintainers")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Local file version history, backup and recovery")
set(CPACK_PACKAGE_DESCRIPTION "ZcVersionBox keeps local file history in isolated Git repositories and supports backup, recovery and optional AI assistance.")
set(CPACK_PACKAGE_VERSION "$ENV{ZC_PACKAGE_VERSION}")
set(CPACK_DEBIAN_PACKAGE_VERSION "$ENV{ZC_PACKAGE_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "ZcVersionBox-$ENV{ZC_PACKAGE_TAG}-linux-amd64")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE amd64)
set(CPACK_DEBIAN_PACKAGE_SECTION utils)
set(CPACK_DEBIAN_PACKAGE_PRIORITY optional)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "git (>= 1:2.29), ca-certificates, libssl3 | libssl3t64, libxcb-cursor0, hicolor-icon-theme")
set(CPACK_DEBIAN_PACKAGE_RECOMMENDS "fonts-noto-cjk")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS_PRIVATE_DIRS "$ENV{ZC_LINUX_PAYLOAD}/opt/zcversionbox/lib")
set(CPACK_DEBIAN_COMPRESSION_TYPE xz)
set(CPACK_INSTALLED_DIRECTORIES "$ENV{ZC_LINUX_PAYLOAD};/")
set(CPACK_PACKAGING_INSTALL_PREFIX "/")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
